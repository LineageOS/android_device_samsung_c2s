        <point>
            <value>0.3569</value>
            <nits>276.5</nits>
        </point>
        <point>
            <value>0.4059</value>
            <nits>326.5</nits>
        </point>
        <point>
            <value>0.4255</value>
            <nits>346</nits>
        </point>
        <point>
            <value>0.4451</value>
            <nits>386.7</nits>
        </point>
        <point>
            <value>0.4804</value>
            <nits>459.3</nits>
        </point>
        <point>
            <value>0.5</value>
