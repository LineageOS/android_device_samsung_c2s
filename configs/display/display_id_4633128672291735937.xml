        </density>
        <density>
            <height>1440</height>
            <width>3088</width>
            <density>560</density>
        </density>
    </densityMapping>
    <screenBrightnessMap>
        <point>
            <value>0.0</value>
            <nits>2</nits>
        </point>
        <point>
            <value>0.0255</value>
            <nits>10.6</nits>
